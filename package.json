{
  "name": "@sainzs/memex",
  "version": "0.1.1",
  "description": "A maintained corpus of pathological file paths — Unicode normalization, reserved names, bidi, control chars — plus a harness to test any tool against them.",
  "license": "MIT",
  "author": "Santiago Sainz <214846064+sainzs@users.noreply.github.com> (https://github.com/sainzs)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainzs/memex.git"
  },
  "homepage": "https://github.com/sainzs/memex#readme",
  "bugs": "https://github.com/sainzs/memex/issues",
  "keywords": [
    "unicode",
    "normalization",
    "nfc",
    "nfd",
    "filesystem",
    "testing",
    "fuzzing",
    "fixtures",
    "ci",
    "developer-tools",
    "codex"
  ],
  "type": "module",
  "bin": {
    "memex": "bin/memex.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "lib/",
    "corpus/",
    "scripts/build-corpus.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "corpus:build": "node scripts/build-corpus.js",
    "corpus:validate": "node scripts/build-corpus.js --check",
    "check": "npm run corpus:validate && npm test && node bin/memex.js check ."
  },
  "dependencies": {}
}
